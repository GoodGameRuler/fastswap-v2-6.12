+/*
+ * Load the target folio from far memory on this cpu before the readahead is
+ * issued; the caller polls the returned cpu afterwards.
+ */
+static int swapin_read_target(swp_entry_t entry, gfp_t gfp_mask,
+			      struct mempolicy *mpol, pgoff_t ilx)
+{
+	bool page_allocated;
+	struct folio *folio;
+	int cpu;
+
+	if (!IS_ENABLED(CONFIG_FASTSWAP)) {
+		return 0;
+	}
+
+	folio = __read_swap_cache_async(entry, gfp_mask, mpol, ilx,
+					&page_allocated, false);
+	if (!folio) {
+		return 0;
+	}
+
+	migrate_disable();
+	cpu = smp_processor_id();
+	if (page_allocated && !fastswap_load(folio, true)) {
+		swap_read_folio(folio, NULL);
+	}
+	migrate_enable();
+
+	folio_put(folio);
+	return cpu;
+}
