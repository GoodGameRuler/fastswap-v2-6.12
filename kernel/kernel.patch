+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _LINUX_FASTSWAP_H
+#define _LINUX_FASTSWAP_H
+
+#include <linux/swap.h>
+
+struct fastswap_ops {
+	int (*store)(unsigned type, pgoff_t index, struct folio *folio);
+	int (*load)(unsigned type, pgoff_t index, struct folio *folio);
+	int (*load_async)(unsigned type, pgoff_t index, struct folio *folio);
+	int (*poll_load)(int cpu);
+};
+
+#ifdef CONFIG_FASTSWAP
+#define FASTSWAP_MAP_LONGS(pages)	BITS_TO_LONGS(pages)
+int fastswap_register_ops(const struct fastswap_ops *ops);
+bool fastswap_store(struct folio *folio);
+bool fastswap_load(struct folio *folio, bool sync);
+void fastswap_poll_load(int cpu);
+void fastswap_clear(struct swap_info_struct *si, pgoff_t offset, unsigned int nr);
+#else
+#define FASTSWAP_MAP_LONGS(pages)	0
+static inline bool fastswap_store(struct folio *folio) { return false; }
+static inline bool fastswap_load(struct folio *folio, bool sync) { return false; }
+static inline void fastswap_poll_load(int cpu) { }
+static inline void fastswap_clear(struct swap_info_struct *si, pgoff_t offset,
+				  unsigned int nr) { }
+#endif
+
+#endif
