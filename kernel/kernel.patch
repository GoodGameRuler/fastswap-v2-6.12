diff --git a/mm/fastswap.c b/mm/fastswap.c
new file mode 100644
index 000000000000..0a1c0a80eddc
--- /dev/null
+++ b/mm/fastswap.c
@@ -0,0 +1,113 @@
+// SPDX-License-Identifier: GPL-2.0
+/* Far-memory swap hook: stores and loads swap slots through a backend module. */
+#include <linux/fastswap.h>
+#include <linux/debugfs.h>
+#include <linux/module.h>
+#include <linux/swapops.h>
+
+static const struct fastswap_ops *fastswap_backend;
+static u64 loads, succ_stores, failed_stores, invalidates;
+static atomic_t curr_pages;
+
+/* The far-memory bitmap follows the zeromap in the same allocation. */
+static unsigned long *far_map(struct swap_info_struct *si)
+{
+	return si->zeromap + BITS_TO_LONGS(si->max);
+}
+
+int fastswap_register_ops(const struct fastswap_ops *new_ops)
+{
+	if (READ_ONCE(fastswap_backend)) {
+		return -EBUSY;
+	}
+
+	smp_store_release(&fastswap_backend, new_ops);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(fastswap_register_ops);
+
+void fastswap_clear(struct swap_info_struct *si, pgoff_t offset, unsigned int nr)
+{
+	unsigned int i;
+
+	for (i = 0; i < nr; i++) {
+		if (test_and_clear_bit(offset + i, far_map(si))) {
+			atomic_dec(&curr_pages);
+			data_race(invalidates++);
+		}
+	}
+}
+
+bool fastswap_store(struct folio *folio)
+{
+	struct swap_info_struct *si = swp_swap_info(folio->swap);
+	pgoff_t offset = swp_offset(folio->swap);
+	const struct fastswap_ops *ops = READ_ONCE(fastswap_backend);
+
+	if (!ops || folio_test_large(folio)) {
+		return false;
+	}
+
+	if (ops->store(si->type, offset, folio)) {
+		data_race(failed_stores++);
+		return false;
+	}
+
+	if (!test_and_set_bit(offset, far_map(si))) {
+		atomic_inc(&curr_pages);
+	}
+	data_race(succ_stores++);
+
+	return true;
+}
+
+/* True if the slot is in far memory and the backend now owns the folio. */
+bool fastswap_load(struct folio *folio, bool sync)
+{
+	struct swap_info_struct *si = swp_swap_info(folio->swap);
+	pgoff_t offset = swp_offset(folio->swap);
+	unsigned int nr = folio_nr_pages(folio);
+	const struct fastswap_ops *ops = READ_ONCE(fastswap_backend);
+
+	if (!ops) {
+		return false;
+	}
+
+	/* Large folios are never stored; THP swapin is not gated as THP is off. */
+	if (nr > 1) {
+		WARN_ON_ONCE(find_next_bit(far_map(si), offset + nr, offset) < offset + nr);
+		return false;
+	}
+
+	if (!test_bit(offset, far_map(si))) {
+		return false;
+	}
+
+	data_race(loads++);
+	(sync ? ops->load : ops->load_async)(si->type, offset, folio);
+
+	return true;
+}
+
+void fastswap_poll_load(int cpu)
+{
+	const struct fastswap_ops *ops = READ_ONCE(fastswap_backend);
+
+	if (ops) {
+		ops->poll_load(cpu);
+	}
+}
+
+static int __init fastswap_debugfs_init(void)
+{
+	struct dentry *root = debugfs_create_dir("frontswap", NULL);
+
+	debugfs_create_u64("loads", 0444, root, &loads);
+	debugfs_create_u64("succ_stores", 0444, root, &succ_stores);
+	debugfs_create_u64("failed_stores", 0444, root, &failed_stores);
+	debugfs_create_u64("invalidates", 0444, root, &invalidates);
+	debugfs_create_atomic_t("curr_pages", 0444, root, &curr_pages);
+
+	return 0;
+}
+module_init(fastswap_debugfs_init);
