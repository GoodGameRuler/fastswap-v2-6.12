CompileFlags:
  Remove: [-mpreferred-stack-boundary=*, -mindirect-branch*, -mfunction-return=*, -fconserve-stack, -falign-jumps=*, -falign-loops=*, -fno-allow-store-data-races, -fno-var-tracking-assignments, -mrecord-mcount, -fmin-function-alignment=*, -fsanitize=*, -fno-ipa-sra, -mskip-rax-setup, -mno-fp-ret-in-387, -fzero-call-used-regs=*, -fno-stack-clash-protection, -Wno-alloc-size-larger-than, -Wimplicit-fallthrough=*, -Wno-stringop-truncation, -Wno-restrict, -Wno-maybe-uninitialized, -Wno-dangling-pointer, -Wno-format-overflow, -Wno-format-truncation, -Wno-array-bounds, -Wno-unused-but-set-variable, -Wno-packed-not-aligned, -Wno-stringop-overflow]
